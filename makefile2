# ─────────────────────────────────────────────────────────
#  passcompass Makefile  –  type `make help` for a list
# ─────────────────────────────────────────────────────────
.PHONY: help env lint test mlflow-up mlflow-down mlflow-ui \
        prefect-up deploy train clean

# ≡≡≡ Environment ≡≡≡
env:
	conda env create -f environment.yml || conda env update -f environment.yml
	@echo "👉  Activate with:   conda activate passcompass-ml"

# ≡≡≡ Code quality & tests ≡≡≡
lint:
	ruff src tests

test:
	pytest -q

# ≡≡≡ MLflow server ≡≡≡
MLFLOW_URI := sqlite:///mlflow.db
MLFLOW_PORT := 5001

mlflow-up:
	MLFLOW_TRACKING_URI=$(MLFLOW_URI) \
	mlflow server \
	  --backend-store-uri $(MLFLOW_URI) \
	  --default-artifact-root file:./artifacts \
	  --serve-artifacts \
	  -h 0.0.0.0 -p $(MLFLOW_PORT) & \
	echo $$! > .mlflow.pid && \
	echo "🚀 MLflow UI → http://127.0.0.1:$(MLFLOW_PORT)"

mlflow-ui:
	open http://127.0.0.1:$(MLFLOW_PORT)

mlflow-down:
	@kill `cat .mlflow.pid` 2>/dev/null || true
	@rm -f .mlflow.pid
	@echo "🛑 MLflow server stopped"

# ≡≡≡ Prefect ≡≡≡
prefect-up:
	prefect server start

deploy:
	prefect deploy

train:
	prefect deployment run train_logreg_flow/dev

# ≡≡≡ House-keeping ≡≡≡
clean:
	rm -rf artifacts/* __pycache__ .pytest_cache

help:  ## Show this help.
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## " ; printf "\nTargets:\n"} {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'
